{{ 'component-hero-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}

  /* =========================================================
     HERO SPACING
  ========================================================= */

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }


  /* =========================================================
     HERO CONTAINER
  ========================================================= */

  #HeroBanner-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 82vh;
    overflow: hidden;
  }


  /* =========================================================
     MEDIA
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__media-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  #HeroBanner-{{ section.id }} .hero-banner__media-wrap video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  #HeroBanner-{{ section.id }} .hero-banner__image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }


  /* =========================================================
     DESKTOP IMAGE
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__image--desktop {
    display: block;
    object-position: center center;
  }


  /* =========================================================
     MOBILE IMAGE
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__image--mobile {
    display: none;
  }


  /* =========================================================
     OVERLAY
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__scrim {
    position: absolute;
    inset: 0;

    z-index: 2;

    pointer-events: none;

    /*
      Very subtle overlay.
      Keeps the product image natural while
      helping the left-side text remain readable.
    */

    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.08) 0%,
        rgba(0, 0, 0, 0.025) 38%,
        rgba(0, 0, 0, 0) 68%
      );
  }


  /* =========================================================
     CONTENT CONTAINER
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__inner {
    position: relative;

    z-index: 5;

    min-height: 82vh;

    display: flex;
    align-items: center;
    justify-content: flex-start;

    width: 100%;
  }


  /* =========================================================
     TEXT CONTENT
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__content {
    position: relative;

    z-index: 6;

    width: 44%;
    max-width: 570px;

    padding-top: 50px;
    padding-bottom: 50px;

    text-align: left;

    color: rgb(var(--color-foreground));
  }


  /* =========================================================
     EYEBROW
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__eyebrow {
    margin: 0 0 22px;

    color: rgb(var(--color-foreground)) !important;

    font-family: var(--font-body-family);

    font-size: 11px;
    font-weight: 600;

    line-height: 1.4;

    letter-spacing: 0.24em;

    text-transform: uppercase;
  }


  /* =========================================================
     HEADING
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__heading {
    margin: 0;

    max-width: 560px;

    color: rgb(var(--color-foreground)) !important;

    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);

    font-size: clamp(48px, 5vw, 80px);

    line-height: 0.96;

    letter-spacing: -0.035em;

    text-align: left;
  }


  /* =========================================================
     SUBHEADING
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__subheading {
    margin: 27px 0 0;

    max-width: 440px;

    color: rgb(var(--color-foreground)) !important;

    font-family: var(--font-body-family);

    font-size: 16px;

    line-height: 1.65;

    letter-spacing: 0;

    text-align: left;
  }


  /* =========================================================
     BUTTON WRAPPER
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__buttons {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 12px;

    margin-top: 34px;
  }


  /* =========================================================
     BUTTONS
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__button {
    min-height: 52px;

    padding: 0 28px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    border-radius: 0;

    font-family: var(--font-body-family);

    font-size: 11px;

    font-weight: 600;

    line-height: 1;

    letter-spacing: 0.16em;

    text-transform: uppercase;

    text-decoration: none;

    cursor: pointer;

    transition:
      transform 0.25s ease,
      opacity 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;
  }


  /* =========================================================
     PRIMARY BUTTON
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__button:not(.button--secondary) {
    background-color: rgb(var(--color-button)) !important;

    color: rgb(var(--color-button-text)) !important;

    border: 1px solid rgb(var(--color-button)) !important;
  }


  /* =========================================================
     SECONDARY BUTTON
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__button.button--secondary {
    background-color: transparent !important;

    color: rgb(var(--color-foreground)) !important;

    border: 1px solid rgba(var(--color-foreground), 0.45) !important;
  }


  /* =========================================================
     BUTTON HOVER
  ========================================================= */

  #HeroBanner-{{ section.id }} .hero-banner__button:hover {
    transform: translateY(-2px);

    opacity: 0.88;
  }


  /* =========================================================
     DESKTOP
  ========================================================= */

  @media screen and (min-width: 750px) {

    #HeroBanner-{{ section.id }} {
      min-height: 82vh;
    }

    #HeroBanner-{{ section.id }} .hero-banner__inner {
      min-height: 82vh;

      align-items: center;
    }

    #HeroBanner-{{ section.id }} .hero-banner__content {
      width: 44%;

      max-width: 570px;

      padding-left: 0;
      padding-right: 30px;
    }

  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (min-width: 750px) and (max-width: 1100px) {

    #HeroBanner-{{ section.id }} .hero-banner__content {
      width: 48%;
    }

    #HeroBanner-{{ section.id }} .hero-banner__heading {
      font-size: clamp(44px, 6vw, 64px);
    }

    #HeroBanner-{{ section.id }} .hero-banner__subheading {
      max-width: 390px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

/* =========================================================
   MOBILE HERO — TEXT TOP / BOTTLE BOTTOM
========================================================= */

@media screen and (max-width: 749px) {

  #HeroBanner-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 760px;
    min-height: 760px;
    overflow: hidden;
  }

  /* -----------------------------------------
     MOBILE IMAGE
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__media-wrap {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    z-index: 1;
  }

  /* Hide desktop image */
  #HeroBanner-{{ section.id }} .hero-banner__image--desktop {
    display: none !important;
  }

  /* Show ONLY mobile image */
  #HeroBanner-{{ section.id }} .hero-banner__image--mobile {
    display: block !important;

    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    /* Bottle toward bottom/center */
    object-position: center bottom;
  }


  /* -----------------------------------------
     IMAGE OVERLAY
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__scrim {
    position: absolute;
    inset: 0;

    z-index: 2;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,0.06) 0%,
        rgba(255,255,255,0) 45%,
        rgba(0,0,0,0.04) 100%
      );
  }


  /* -----------------------------------------
     TEXT CONTAINER
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__inner {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;
    min-height: 760px;

    padding: 0 22px !important;

    display: block;

    z-index: 5;

    pointer-events: none;
  }


  /* -----------------------------------------
     TEXT — TOP LEFT
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__content {
    position: absolute;

    top: 32px;
    left: 22px;

    width: calc(100% - 44px);

    max-width: 340px;

    padding: 0 !important;
    margin: 0 !important;

    text-align: left !important;

    z-index: 10;

    pointer-events: auto;
  }


  /* -----------------------------------------
     EYEBROW
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__eyebrow {
    margin: 0 0 16px;

    font-size: 9px;

    line-height: 1.4;

    letter-spacing: 0.20em;

    text-align: left !important;
  }


  /* -----------------------------------------
     HEADING
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__heading {
    margin: 0;

    width: 100%;
    max-width: 320px;

    font-size: clamp(42px, 11vw, 58px);

    line-height: 0.94;

    letter-spacing: -0.035em;

    text-align: left !important;
  }


  /* -----------------------------------------
     DESCRIPTION
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__subheading {
    margin: 18px 0 0;

    width: 100%;

    max-width: 310px;

    font-size: 14px;

    line-height: 1.5;

    text-align: left !important;
  }


  /* -----------------------------------------
     BUTTONS
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__buttons {
    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: 9px;

    margin-top: 22px;

    width: auto;
  }


  #HeroBanner-{{ section.id }} .hero-banner__button {
    display: inline-flex;

    width: auto !important;

    min-width: 160px;

    min-height: 48px;

    padding: 0 20px;

    margin: 0;

    font-size: 9px;

    letter-spacing: 0.14em;

    white-space: nowrap;
  }


  /* -----------------------------------------
     IMPORTANT:
     DO NOT SHOW ANY SECOND IMAGE
  ----------------------------------------- */

  #HeroBanner-{{ section.id }} .hero-banner__image--desktop {
    display: none !important;
  }

}

{%- endstyle -%}


<div
  id="HeroBanner-{{ section.id }}"
  class="
    hero-banner
    color-{{ section.settings.color_scheme }}
    gradient
    section-{{ section.id }}-padding
    {% if section.settings.desktop_image != blank
      or section.settings.mobile_image != blank
      or section.settings.video != blank
    %}
      hero-banner--media
    {% endif %}
  "
>


  {%- comment -%}
    =========================================================
    HERO MEDIA
    =========================================================
  {%- endcomment -%}


  {%- if section.settings.video != blank -%}

    <!-- Background Video -->

    <div
      class="hero-banner__media-wrap"
      aria-hidden="true"
    >

      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          image_size: '1920x'
      }}

      <div class="hero-banner__scrim"></div>

    </div>


  {%- elsif section.settings.desktop_image != blank or section.settings.mobile_image != blank -%}

    <!-- Responsive Hero Images -->

    <div
      class="hero-banner__media-wrap"
      aria-hidden="true"
    >


      {%- if section.settings.desktop_image != blank -%}

        {{
          section.settings.desktop_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '1200,1600,1920,2200,2400',
            sizes: '100vw',
            class: 'hero-banner__image hero-banner__image--desktop'
        }}

      {%- endif -%}


      {%- if section.settings.mobile_image != blank -%}

        {{
          section.settings.mobile_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600,750,900,1200',
            sizes: '100vw',
            class: 'hero-banner__image hero-banner__image--mobile'
        }}

      {%- elsif section.settings.desktop_image != blank -%}

        <!-- Desktop image fallback for mobile -->

        {{
          section.settings.desktop_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600,750,900,1200',
            sizes: '100vw',
            class: 'hero-banner__image hero-banner__image--mobile'
        }}

      {%- endif -%}


      <div class="hero-banner__scrim"></div>

    </div>


  {%- else -%}

    <!-- Default background -->

    <div
      class="hero-banner__rings"
      aria-hidden="true"
    >

      <span class="hero-banner__ring hero-banner__ring--1"></span>

      <span class="hero-banner__ring hero-banner__ring--2"></span>

      <span class="hero-banner__ring hero-banner__ring--3"></span>

    </div>

  {%- endif -%}



  {%- comment -%}
    =========================================================
    HERO TEXT
    =========================================================
  {%- endcomment -%}


  <div class="hero-banner__inner page-width">

    <div class="hero-banner__content">


      {%- if section.settings.eyebrow != blank -%}

        <p class="hero-banner__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>

      {%- endif -%}



      {%- if section.settings.heading != blank -%}

        <h1 class="hero-banner__heading">
          {{ section.settings.heading }}
        </h1>

      {%- endif -%}



      {%- if section.settings.subheading != blank -%}

        <p class="hero-banner__subheading">
          {{ section.settings.subheading }}
        </p>

      {%- endif -%}



      {%- if section.settings.button_label != blank
        or section.settings.button_label_2 != blank
      -%}

        <div class="hero-banner__buttons">


          {%- if section.settings.button_label != blank -%}

            <a
              href="{{ section.settings.button_link | default: '#' }}"
              class="button hero-banner__button"
            >
              {{ section.settings.button_label | escape }}
            </a>

          {%- endif -%}



          {%- if section.settings.button_label_2 != blank -%}

            <a
              href="{{ section.settings.button_link_2 | default: '#' }}"
              class="button button--secondary hero-banner__button"
            >
              {{ section.settings.button_label_2 | escape }}
            </a>

          {%- endif -%}


        </div>

      {%- endif -%}


    </div>

  </div>

</div>



{% schema %}

{
  "name": "Hero banner",
  "class": "section",

  "settings": [

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },


    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Hero Image",
      "info": "Recommended: 1920 × 900 px"
    },


    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Hero Image",
      "info": "Recommended: 900 × 1200 px"
    },


    {
      "type": "video",
      "id": "video",
      "label": "Background video (optional)",
      "info": "Video takes priority over the desktop and mobile images."
    },


    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Premium Fragrances"
    },


    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Than a Scent, It's a Statement."
    },


    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover timeless fragrances crafted for those who leave a lasting impression."
    },


    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },


    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },


    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Discover"
    },


    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },


    {
      "type": "header",
      "content": "Section spacing"
    },


    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },


    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }

  ],


  "presets": [
    {
      "name": "Hero banner"
    }
  ]

}

{% endschema %}