{% comment %}
  Renders a full-screen preloader shown only on the homepage while the
  rest of the page finishes loading: a perfume bottle (cap lifts off,
  sprays a gold mist that blooms and swallows the bottle) dissolving
  into the wordmark with a glowing gold underline.

  Usage:
  {% render 'homepage-preloader' %}
{% endcomment %}
{{ 'component-homepage-preloader.css' | asset_url | stylesheet_tag }}
<div
  class="homepage-preloader"
  id="HomepagePreloader"
  role="status"
  aria-label="Loading"
>
  <div class="homepage-preloader__stage">
    <div class="homepage-preloader__bottle-wrap">
      <svg
        class="homepage-preloader__bottle"
        viewBox="0 0 160 260"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <ellipse class="homepage-preloader__glow" cx="80" cy="235" rx="46" ry="10" />

        <g class="homepage-preloader__spray">
          <circle cx="150" cy="30" r="3.5" />
          <circle cx="160" cy="26" r="2.5" />
          <circle cx="168" cy="34" r="3" />
          <circle cx="155" cy="20" r="2" />
          <circle cx="163" cy="40" r="2.5" />
          <circle cx="172" cy="24" r="2" />
        </g>

        <g class="homepage-preloader__cap">
          <rect x="58" y="10" width="44" height="34" rx="6" fill="currentColor" />
          <rect x="76" y="42" width="8" height="10" fill="currentColor" opacity="0.85" />
        </g>

        <circle class="homepage-preloader__nozzle" cx="140" cy="30" r="5" fill="currentColor" />
        <rect x="102" y="26" width="40" height="8" rx="4" fill="currentColor" />
        <rect x="72" y="40" width="16" height="20" fill="currentColor" />
        <path d="M60 60 L100 60 L118 88 L42 88 Z" fill="currentColor" />
        <rect x="30" y="88" width="100" height="140" rx="16" fill="currentColor" opacity="0.9" />
        <rect x="42" y="150" width="76" height="46" rx="2" fill="rgb(var(--color-background))" opacity="0.9" />
        <text x="80" y="170" text-anchor="middle" class="homepage-preloader__label-text">PERFUMINATI</text>
        <text x="80" y="184" text-anchor="middle" class="homepage-preloader__label-subtext">Extrait de Parfum</text>
      </svg>

      <div class="homepage-preloader__mist-bloom"></div>
    </div>

    <div class="homepage-preloader__word">{{ shop.name | default: 'PERFUMINATI' }}</div>
    <span class="homepage-preloader__glow-line"></span>
  </div>
</div>
<script>
  (function () {
    var preloader = document.getElementById('HomepagePreloader');
    if (!preloader) return;

    var minDisplayMs = 5600;
    var start = Date.now();

    function reveal() {
      var elapsed = Date.now() - start;
      var wait = Math.max(minDisplayMs - elapsed, 0);
      setTimeout(function () {
        preloader.setAttribute('data-loaded', '');
        setTimeout(function () {
          if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
        }, 750);
      }, wait);
    }

    if (document.readyState === 'complete') {
      reveal();
    } else {
      window.addEventListener('load', reveal);
    }
  })();
</script>
