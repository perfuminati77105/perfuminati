{% comment %}
  Renders a full-screen preloader shown only on the homepage while the
  rest of the page finishes loading: an animated perfume atomizer bottle
  spraying mist, with the shop name fading in beneath it.

  Usage:
  {% render 'homepage-preloader' %}
{% endcomment %}
{{ 'component-homepage-preloader.css' | asset_url | stylesheet_tag }}
<div
  class="homepage-preloader color-scheme-4"
  id="HomepagePreloader"
  role="status"
  aria-label="Loading"
>
  <div class="homepage-preloader__stage">
    <svg
      class="homepage-preloader__bottle"
      viewBox="0 0 160 260"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <g class="homepage-preloader__mist">
        <circle cx="118" cy="24" r="4" />
        <circle cx="122" cy="20" r="3" />
        <circle cx="114" cy="18" r="3.5" />
        <circle cx="126" cy="26" r="2.5" />
        <circle cx="110" cy="24" r="2.5" />
      </g>
      <g class="homepage-preloader__pump">
        <circle cx="118" cy="26" r="4" fill="currentColor" />
        <rect x="100" y="20" width="20" height="8" rx="4" fill="currentColor" />
        <rect x="60" y="14" width="46" height="26" rx="8" fill="currentColor" />
      </g>
      <rect x="72" y="40" width="16" height="22" fill="currentColor" />
      <path d="M60 62 L100 62 L118 90 L42 90 Z" fill="currentColor" />
      <rect x="30" y="90" width="100" height="150" rx="18" fill="currentColor" opacity="0.92" />
      <rect x="30" y="150" width="100" height="30" fill="rgb(var(--color-background))" opacity="0.15" />
      <rect x="24" y="228" width="112" height="18" rx="6" fill="currentColor" />
    </svg>
    <div class="homepage-preloader__word">{{ shop.name | default: 'PERFUMINATI' }}</div>
  </div>
</div>
<script>
  (function () {
    var preloader = document.getElementById('HomepagePreloader');
    if (!preloader) return;

    var minDisplayMs = 1400;
    var start = Date.now();

    function reveal() {
      var elapsed = Date.now() - start;
      var wait = Math.max(minDisplayMs - elapsed, 0);
      setTimeout(function () {
        preloader.setAttribute('data-loaded', '');
        setTimeout(function () {
          if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
        }, 750);
      }, wait);
    }

    if (document.readyState === 'complete') {
      reveal();
    } else {
      window.addEventListener('load', reveal);
    }
  })();
</script>
