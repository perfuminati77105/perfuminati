{% comment %}
  Renders a full-screen preloader shown only on the homepage while the
  rest of the page finishes loading: a centered wordmark reveal over a
  dark ambient gradient, with drifting soft-glow "mist" behind it.

  Usage:
  {% render 'homepage-preloader' %}
{% endcomment %}
{{ 'component-homepage-preloader.css' | asset_url | stylesheet_tag }}
<div
  class="homepage-preloader color-scheme-4"
  id="HomepagePreloader"
  role="status"
  aria-label="Loading"
>
  <div class="homepage-preloader__mist" aria-hidden="true">
    <span class="homepage-preloader__orb homepage-preloader__orb--1"></span>
    <span class="homepage-preloader__orb homepage-preloader__orb--2"></span>
    <span class="homepage-preloader__orb homepage-preloader__orb--3"></span>
  </div>
  <div class="homepage-preloader__stage">
    <div class="homepage-preloader__word">{{ shop.name | default: 'PERFUMINATI' }}</div>
    <p class="homepage-preloader__subtitle">Fragrances</p>
    <p class="homepage-preloader__tagline">Designed to be remembered</p>
    <div class="homepage-preloader__welcome">
      <span>Welcome</span>
      <span class="homepage-preloader__welcome-line"></span>
    </div>
  </div>
</div>
<script>
  (function () {
    var preloader = document.getElementById('HomepagePreloader');
    if (!preloader) return;

    var minDisplayMs = 1600;
    var start = Date.now();

    function reveal() {
      var elapsed = Date.now() - start;
      var wait = Math.max(minDisplayMs - elapsed, 0);
      setTimeout(function () {
        preloader.setAttribute('data-loaded', '');
        setTimeout(function () {
          if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
        }, 750);
      }, wait);
    }

    if (document.readyState === 'complete') {
      reveal();
    } else {
      window.addEventListener('load', reveal);
    }
  })();
</script>
